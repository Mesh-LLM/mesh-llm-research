python := env_var_or_default('MESH_RESEARCH_PYTHON', 'python3.12')

prepare:
    UV_PYTHON_DOWNLOADS=never uv sync --locked --group test --python {{python}}

offline-tests:
    uv run --locked --no-sync python -m pytest gguf-py/tests/test_metadata.py gguf-py/tests/test_gguf_reader_validation.py

converter-help:
    uv run --locked --no-sync python convert_hf_to_gguf.py --help
